#!/bin/sh
set -eu
export LC_ALL=C

if [ "${1:-}" = --help ] || [ "${1:-}" = -h ]; then
    printf 'Usage: about\n'
    exit
fi

portfolio=$(dirname "$0")/..
share=$portfolio/share
table=$portfolio/lib/table.awk

link() {
    if [ -t 1 ]; then
        printf '\033]8;;%s\033\\%s\033]8;;\033\\' "$2" "$1"
    else
        printf '%s' "$1"
    fi
}

heading() {
    if [ -t 1 ]; then
        printf '\n\033[1m%s\033[0m\n' "$1"
    else
        printf '\n%s\n' "$1"
    fi
}

printf "Hey, I'm Akash, Software Engineer at "
link Sumble https://sumble.com
printf '\n'
heading EXPERIENCE
awk -v widths=15,30,28 -f "$table" "$share/experience.tsv"
heading INTERNSHIPS
awk -v widths=15,30,28 -f "$table" "$share/internships.tsv"
printf '\n'

tab=$(printf '\t')
while IFS="$tab" read -r label text href; do
    printf '%s: ' "$label"
    link "$text" "$href"
    printf '\n'
done < "$share/contacts.tsv"
