#!/bin/sh

if [ "${1:-}" = --help ] || [ "${1:-}" = -h ]; then
    printf 'Usage: catsay [TEXT ...]\n'
    exit
fi
if [ "$#" -eq 0 ]; then
    set -- Meow
fi
text=$*

LC_ALL=C
export LC_ALL

CATSAY_TEXT=$text awk '
function repeat(s, n, result) {
    result = ""
    while (n-- > 0)
        result = result s
    return result
}

BEGIN {
    text = ENVIRON["CATSAY_TEXT"]
    wrap_width = 36
    max_width = 40
    max_height = 5

    n = split(text, words, /[[:space:]]+/)
    count = 0
    line = ""

    for (i = 1; i <= n; i++) {
        word = words[i]
        if (word == "")
            continue

        if (length(line) + length(word) > wrap_width) {
            if (line != "") {
                count++
                lines[count] = line
                line = ""
            }
            while (length(word) > wrap_width) {
                count++
                lines[count] = substr(word, 1, wrap_width)
                word = substr(word, wrap_width + 1)
            }
        }

        if (line != "")
            line = line " "
        line = line word
    }

    if (line != "") {
        count++
        lines[count] = line
    }

    bubble_width = 20
    if (count > 0 && length(lines[1]) + 4 > bubble_width)
        bubble_width = length(lines[1]) + 4
    bubble_height = count < max_height ? count : max_height
    for (i = 2; i <= bubble_height; i++) {
        if (length(lines[i]) + 3 > bubble_width)
            bubble_width = length(lines[i]) + 3
    }
    if (bubble_width > max_width)
        bubble_width = max_width

    printf " %s\n", repeat("_", bubble_width)

    for (i = 1; i <= bubble_height; i++) {
        if (bubble_height == 1) {
            prefix = "< "
            suffix = " >"
        } else if (i == 1) {
            prefix = "/ "
            suffix = " \\"
        } else if (i == bubble_height) {
            prefix = "\\ "
            suffix = " /"
        } else {
            prefix = "| "
            suffix = " |"
        }

        pad = bubble_width - length(lines[i]) - 3
        printf "%s%s%s%s\n", prefix, lines[i], repeat(" ", pad), suffix
    }

    printf " %s\n", repeat("-", bubble_width)
    printf "     /\n"
    printf "    /\n"
    printf "  /\\_/\\  (\n"
    printf " ( ^.^ ) _)\n"
    printf "   \\\"/  (\n"
    printf " ( | | )\n"
    printf "(__d b__)\n"
}
'
